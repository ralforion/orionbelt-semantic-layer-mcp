{
  "sql": "SELECT\n  \"Countries\".\"countryname\" AS \"Country Name\",\n  CAST(SUM(\"Sales\".\"salesamount\") AS DECIMAL(18, 2)) AS \"Total Sales\",\n  CAST(COUNT(DISTINCT \"Sales\".\"salesclient\") AS BIGINT) AS \"Distinct Clients\"\nFROM \"orionbelt_1\".\"sales\" AS \"Sales\"\nLEFT JOIN \"orionbelt_1\".\"clients\" AS \"Clients\"\n  ON \"Sales\".\"salesclient\" = \"Clients\".\"clientid\"\nLEFT JOIN \"orionbelt_1\".\"countries\" AS \"Countries\"\n  ON \"Clients\".\"clientcountryid\" = \"Countries\".\"countryid\"\nGROUP BY ALL\nORDER BY\n  SUM(\"Sales\".\"salesamount\") DESC\nLIMIT 25",
