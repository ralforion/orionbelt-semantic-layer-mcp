# OrionBelt Semantic Layer MCP — environment configuration
# Copy to .env and adjust as needed.

# OrionBelt Semantic Layer REST API URL (required)
API_BASE_URL=https://orionbelt.ralforion.com

# Who this server is to the API: none | api_key | oidc_client_credentials |
# oidc_user. Unset: api_key when API_KEY is set, none otherwise.
# MCP_AUTH_MODE=

# api_key: a key from the API's API_KEYS (one shared identity), or your BI
# token (obsl_tok_…) from OBSL's /tokens page, with which OBSL runs as you.
# API_KEY=
# Header the credential is sent in; must match the API's API_KEY_HEADER.
# API_KEY_HEADER=X-API-Key

# oidc_client_credentials and oidc_user: the identity provider and this
# server's confidential client there. OBSL_SCOPE / OBSL_AUDIENCE say what to
# ask it for (Entra: <OBSL app ID URI>/.default).
# OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
# OIDC_TOKEN_ENDPOINT=          # overrides the one from discovery
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET_FILE=/secrets/mcp-client-secret   # or OIDC_CLIENT_SECRET=
# OIDC_CLIENT_AUTH=client_secret_post                  # or client_secret_basic
# OBSL_SCOPE=api://<OBSL app>/.default
# OBSL_AUDIENCE=obsl

# oidc_user only (HTTP): users sign in through their MCP client; the server
# checks their token and exchanges it for one for OBSL (Entra on-behalf-of, or
# RFC 8693 token exchange), so OBSL runs as each user.
# MCP_RESOURCE_URL=https://mcp.example.com/mcp   # the URL users add in Claude
# MCP_AUDIENCE=                 # accepted aud values if not the URL (Entra: client id)
# MCP_SCOPES=api://<MCP app>/mcp.access          # what clients ask the IdP for
# OIDC_EXCHANGE=                # entra_obo | token_exchange (default by issuer)

# TLS to the API — for an API that serves HTTPS itself (API_TLS_* on the API,
# v2.29+) with a private CA, or requires mutual TLS (API_TLS_CLIENT_CA, or a
# gateway that asks for a client certificate). All unset: httpx's default trust
# store and no client certificate. Require an https:// API_BASE_URL.
# API_CA_CERT replaces the default trust store rather than adding to it.
# API_CA_CERT=/certs/ca.crt
# API_CLIENT_CERT=/certs/mcp.crt
# Omit when the key is in the same PEM as the certificate. Unencrypted only —
# the server never prompts for a password (on stdio, stdin is the MCP pipe).
# API_CLIENT_KEY=/certs/mcp.key

# MCP transport: stdio | http | sse
MCP_TRANSPORT=stdio

# Bind host/port for HTTP/SSE transport. The default binds loopback: the
# transport terminates no TLS and authenticates no caller, so anything that
# reaches the port can call every tool with this server's API credential.
MCP_SERVER_HOST=localhost
MCP_SERVER_PORT=9000

# Acknowledges an ingress in front of the HTTP transport that terminates TLS
# AND authenticates callers — silences the startup exposure warning and nothing
# else. On Cloud Run TLS is automatic but caller auth is a deploy-time IAM
# choice, so set this only once you have confirmed the service is not
# --allow-unauthenticated. Leave false if nothing fronts it.
MCP_BEHIND_PROXY=false

# Stateless HTTP: every request is self-contained — no Mcp-Session-Id, no
# stream resumability, no session affinity needed across instances. Default on.
# Ignored for stdio; forced off for sse, which needs a per-connection session.
MCP_STATELESS_HTTP=true

# Cloud Run injects PORT at runtime; takes precedence over MCP_SERVER_PORT
# when set. Leave unset for local dev.
# PORT=

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Log format: console (pretty), json (structured), cloudrun (JSON + GCP severity)
LOG_FORMAT=console

# HTTP timeout in seconds
API_TIMEOUT=30
